# Ollama runtime (LLM + embeddings both run locally).
# Use 127.0.0.1, not localhost: on Windows the name resolves to ::1 first and
# each request pays a ~2s IPv6 connect-failure timeout before falling back.
OLLAMA_HOST=http://127.0.0.1:11434
# aya-expanse is trained for multilingual generation and answers Hebrew far
# better than llama3.1, which is the alternative if you only need English.
LLM_MODEL=aya-expanse:8b
# bge-m3 is multilingual (the course corpus is Hebrew + English), 1024-dim.
# nomic-embed-text is a lighter English-only alternative; switching models
# means deleting data/vector_store and re-ingesting.
EMBED_MODEL=bge-m3

# Paths
DOCUMENTS_DIR=./data/documents
VECTOR_STORE_DIR=./data/vector_store

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# Retrieval
TOP_K=4
# Cosine floor, re-measure whenever EMBED_MODEL changes:
#   python scripts/evaluate.py --calibrate
# With bge-m3 on this corpus: on-topic 0.65-0.76, off-topic 0.41-0.51.
MIN_SCORE=0.58

# Cap on answer length. Generation is the slow step when the model does not fit
# in VRAM, and a grounded answer over four passages rarely needs more.
MAX_ANSWER_TOKENS=400

# Flask
FLASK_PORT=5000
