# Ollama runtime (LLM + embeddings both run locally).
# Use 127.0.0.1, not localhost: on Windows the name resolves to ::1 first and
# each request pays a ~2s IPv6 connect-failure timeout before falling back.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# Paths
DOCUMENTS_DIR=./data/documents
VECTOR_STORE_DIR=./data/vector_store

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# Retrieval
TOP_K=4
# Cosine floor. Measured on this corpus with nomic-embed-text: on-topic
# questions score 0.73-0.89, off-topic ones peak around 0.55.
MIN_SCORE=0.62

# Flask
FLASK_PORT=5000
