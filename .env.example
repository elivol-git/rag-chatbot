# Ollama runtime (LLM + embeddings both run locally)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# Paths
DOCUMENTS_DIR=./data/documents
VECTOR_STORE_DIR=./data/vector_store

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# Retrieval
TOP_K=4
MIN_SCORE=0.30

# Flask
FLASK_PORT=5000
