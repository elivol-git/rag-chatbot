# Build context hygiene: everything here is either rebuilt inside the image,
# bind-mounted at run time, or host-specific.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.idea/
.git/
.gitignore

# The corpus and the index are volumes, not image layers.
data/

# Secrets and host paths: compose passes the values through env_file instead.
.env

# Rebuilt by the frontend stage.
frontend/node_modules/
frontend/dist/

# Not part of the served app.
tests/
scripts/
README.md
